NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL connection. Store real value only in deployment secrets.
DATABASE_URL=
DATABASE_SSL=verify
DB_POOL_MAX=5
PUBLIC_API_BASE_URL=https://your-api-domain.example

# JWT verification settings for the selected identity provider (e.g. Neon Auth).
AUTH_ISSUER=\n# Neon Auth JWTs may omit aud; set only when your configured token includes a required audience.\nAUTH_AUDIENCE=\nAUTH_JWKS_URL=\n\n# Frontend build-time variables (public URLs only; never put secrets here).\nVITE_NEON_AUTH_URL=\nVITE_API_BASE_URL=

# Safaricom Daraja: merchant credentials are supplied per tenant and encrypted at rest. Sandbox only until callback and status-query tests pass.
DARAJA_ENV=sandbox
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CALLBACK_TOKEN=

# Pesapal API 3.0: merchant credentials and IPN ID are supplied per tenant and encrypted at rest. Sandbox only until server-side status verification passes.
PESAPAL_ENV=sandbox
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3

# Merchant-owned provider credentials are encrypted at rest with AES-256-GCM. Generate a 32-byte key using:\n# openssl rand -base64 32\n# Keep this key in deployment secret storage and back it up securely; rotating it requires re-encrypting credentials.\nPROVIDER_CREDENTIALS_ENCRYPTION_KEY=\n\n# All provider credentials belong in deployment secret storage, never source control.

# Optional durable merchant webhook delivery worker. Enable only after applying migration 002.
MERCHANT_WEBHOOK_WORKER_ENABLED=false
# For each endpoint, configure a random secret (32+ characters) under the environment-variable
# name stored in payment_merchant_webhook_endpoints.signing_secret_reference.
# Example: MERCHANT_WEBHOOK_SECRET_MERCHANT_A=<random-secret>
MERCHANT_WEBHOOK_SECRET_MERCHANT_A=
