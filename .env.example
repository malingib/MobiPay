NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL connection. Store real value only in deployment secrets.
DATABASE_URL=
DATABASE_SSL=verify
DB_POOL_MAX=5

# JWT verification settings for the selected identity provider (e.g. Neon Auth).
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Safaricom Daraja: sandbox only until callback and status-query tests pass.
DARAJA_ENV=sandbox
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_TOKEN=

# Pesapal API 3.0: sandbox only until server-side status verification passes.
PESAPAL_ENV=sandbox
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# All provider credentials belong in deployment secret storage, never source control.
