NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL connection. Store real value only in deployment secrets.
DATABASE_URL=
DATABASE_SSL=verify
DB_POOL_MAX=5
PUBLIC_API_BASE_URL=https://your-api-domain.example

# Merchant identity provider (Neon Auth). Used by merchant APIs only.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=

# Frontend build-time variables (public URLs only; never put secrets here).
VITE_NEON_AUTH_URL=
VITE_API_BASE_URL=

# Platform administrator identity is separate from merchant Neon Auth.
ADMIN_USERNAME=
ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=
# Generate with: openssl rand -base64 48
PLATFORM_ADMIN_SESSION_SECRET=

# Safaricom Daraja: merchant credentials encrypted at rest; sandbox only until readiness approval.
DARAJA_ENV=sandbox
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CALLBACK_TOKEN=

# Pesapal API 3.0: merchant credentials encrypted at rest; sandbox only until status verification passes.
PESAPAL_ENV=sandbox
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=

MERCHANT_WEBHOOK_WORKER_ENABLED=false
MERCHANT_WEBHOOK_SECRET_MERCHANT_A=
