{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": "/api/index?__path=/api/v1"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index?__path=/api/v1/$1"
    }
  ]
}
