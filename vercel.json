{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/health", "destination": "/api/index?__path=/health" },
    { "source": "/ready", "destination": "/api/index?__path=/ready" },
    { "source": "/api/v1", "destination": "/api/index?__path=/api/v1" },
    { "source": "/api/v1/(.*)", "destination": "/api/index?__path=/api/v1/$1" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
