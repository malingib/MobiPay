{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/health", "destination": "/api/index?__path=/health" },
    { "source": "/ready", "destination": "/api/index?__path=/ready" },
    { "source": "/api/admin", "destination": "/api/index?__path=/api/admin" },
    { "source": "/api/admin/(.*)", "destination": "/api/index?__path=/api/admin/$1" },
    { "source": "/api/v1", "destination": "/api/index?__path=/api/v1" },
    { "source": "/api/v1/(.*)", "destination": "/api/index?__path=/api/v1/$1" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" }
  ],
  "functions": { "api/index.ts": { "maxDuration": 30 } }
}
